{
  "compilerOptions": {
    "types": ["node", "jest"],

    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true

    // "isolatedModules": true
  },
  "include": ["src", "../auth.test.ts"]
}
